# ==========================================
# Non-modular / Irrelevant Folders
# ==========================================
backend/
frontend/
react/
modular-go-refine-smoke/
modular-go-refine-smoke-final/

# ==========================================
# Dependencies & Build Outputs
# ==========================================
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
bin/
**/bin/
# Executable source is part of the CLI, not build output.
!/create-ridhuan-backend/src/bin/
!/create-ridhuan-backend/src/bin/**
obj/
**/obj/
TestResults/
**/TestResults/
artifacts/
**/artifacts/
# Runtime upload folders only; source modules named "uploads" must stay tracked.
/*/uploads/
/create-ridhuan-backend/templates/*/uploads/
.refresh-publish/
**/.refresh-publish/
nestjs-prototype-snapshot-*.zip

# ==========================================
# Environment & Secrets (Keep .env.example)
# ==========================================
.env
**/.env
.env.*
**/.env.*
.env.local
**/.env.local
.env.*.local
**/.env.*.local
!.env.example
!**/.env.example

# ==========================================
# Temporary & Cache Files
# ==========================================
.tmp-*
**/.tmp-*
*.tmp
**/*.tmp
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# IDE & System Files
# ==========================================
.idea/
**/.idea/
.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
*.user
**/*.user
.DS_Store
Thumbs.db
*.tgz
