DB_PROVIDER=mysql
NODE_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=mysql://backend:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3306/backend?sslmode=disable
JWT_SECRET=replace_with_random_32_or_more_character_secret
# Optional token boundary; enabling either requires newly issued matching tokens.
JWT_ISSUER=
JWT_AUDIENCE=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_this_password
USER_EMAIL=user@example.com
USER_PASSWORD=replace_this_password
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=false
RATE_LIMIT_STORE=memory
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_INTERNAL_WINDOW_MS=900000
RATE_LIMIT_INTERNAL_MAX=300
# Add a typed rate group and env keys in code for a different endpoint quota.
APP_INSTANCE_COUNT=1
# For multiple API replicas, set APP_INSTANCE_COUNT to the replica count and RATE_LIMIT_STORE=redis.
TRUST_PROXY_HOPS=0
ENDPOINT_POLICIES_JSON={}
# Optional notification email; PostgreSQL/SSE work without SMTP.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
UPLOAD_ENABLED=true
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,application/pdf
UPLOAD_ORPHAN_GRACE_HOURS=24
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MYSQL_USER=backend
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_DATABASE=backend
MYSQL_PORT=3306
APP_PORT=8080
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
OTEL_ENABLED=false
OTEL_SERVICE_NAME=modular-golang
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

DATABASE_URL_DOCKER=mysql://backend:CHANGE_ME_DATABASE_PASSWORD@mysql:3306/backend?sslmode=disable

COMPOSE_PROFILES=

COMPOSE_PROJECT_NAME=modular-golang
S3_ENDPOINT_DOCKER=http://minio:9000


# Share this namespace across replicas; use a different namespace per application.
REDIS_NAMESPACE=modular-golang
MYSQL_ROOT_PASSWORD=CHANGE_ME_ADMIN_DATABASE_PASSWORD

# Database email outbox worker; SMTP remains optional.
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=60
WORKER_RENEW_SECONDS=20
WORKER_MAX_ATTEMPTS=5
CLEANUP_BATCH_SIZE=500
CLEANUP_SESSION_DAYS=30
CLEANUP_OUTBOX_DAYS=30
CLEANUP_AUDIT_ENABLED=false
CLEANUP_AUDIT_DAYS=365

# Optional telemetry. Add telemetry to COMPOSE_PROFILES only when enabled.
OTEL_EXPORTER_OTLP_ENDPOINT_DOCKER=http://otel-collector:4318
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
