DB_PROVIDER=mysql
# APP CONFIG
PORT=3000
APP_PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET=change_this_to_a_random_string_at_least_32_chars
JWT_ISSUER=modular-express
JWT_AUDIENCE=modular-express-api
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
USER_EMAIL=user@example.com
USER_PASSWORD=change_this_user_password

# DATABASE CONNECTION (PostgreSQL 18)
# Use 'localhost' for local development (npm run dev)
# Use 'postgres' if running the app via Docker (docker compose up)
DATABASE_URL=mysql://backend:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3306/backend?sslmode=disable

# REDIS CONNECTION (Redis 8)
# Use 'localhost' for local development (npm run dev)
# Use 'redis' if running the app via Docker (docker compose up)
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=false
# Set redis only when the Redis service is running; memory is for one app instance.
RATE_LIMIT_STORE=memory
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_INTERNAL_WINDOW_MS=900000
RATE_LIMIT_INTERNAL_MAX=300
# To add an endpoint-specific limit, define a typed group, its env keys, and registry assignment in code.
APP_INSTANCE_COUNT=1
TRUST_PROXY_HOPS=0
# JSON object: endpoint IDs to audit/rateLimit/cache overrides; requires redeploy.
ENDPOINT_POLICIES_JSON={}

# FILE STORAGE
UPLOAD_ENABLED=true
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,application/pdf
UPLOAD_ORPHAN_GRACE_HOURS=24
# Required when UPLOAD_STORAGE=s3. For local MinIO use the minio Compose profile.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_ENDPOINT_DOCKER=http://minio:9000

# DOCKER INITIALIZATION
# SMTP is optional. Notifications remain in PostgreSQL when email fails.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# These must match the credentials in the connection URLs above
MYSQL_USER=backend
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_DATABASE=app_db
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Run npm run seed:prod explicitly after the first Compose startup.

DATABASE_URL_DOCKER=mysql://backend:CHANGE_ME_DATABASE_PASSWORD@mysql:3306/backend?sslmode=disable

COMPOSE_PROFILES=

COMPOSE_PROJECT_NAME=modular-express


# Share this namespace across replicas; use a different namespace per application.
REDIS_NAMESPACE=modular-express
MYSQL_ROOT_PASSWORD=CHANGE_ME_ADMIN_DATABASE_PASSWORD

# Database email outbox worker; SMTP remains optional.
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=60
WORKER_RENEW_SECONDS=20
WORKER_MAX_ATTEMPTS=5
CLEANUP_BATCH_SIZE=500
CLEANUP_SESSION_DAYS=30
CLEANUP_OUTBOX_DAYS=30
CLEANUP_AUDIT_ENABLED=false
CLEANUP_AUDIT_DAYS=365

# Optional telemetry. Add telemetry to COMPOSE_PROFILES only when enabled.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=modular-express-typescript-starter-postgre
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT_DOCKER=http://otel-collector:4318
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
