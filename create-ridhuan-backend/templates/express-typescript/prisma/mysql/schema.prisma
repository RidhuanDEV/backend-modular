// schema.prisma — v1 Template Base (RBAC Only)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// RBAC MODELS
// ─────────────────────────────────────────

model Role {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  users       User[]
  permissions RolePermission[]

}

model Permission {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(128)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  roles RolePermission[]

}

model RolePermission {
  roleId       String @db.Char(36)
  permissionId String @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────
// CORE MODELS
// ─────────────────────────────────────────

model User {
  id       String  @id @default(uuid()) @db.Char(36)
  email    String  @unique @db.VarChar(255)
  password String @db.VarChar(255)
  roleId   String @db.Char(36)

  // Soft delete
  deletedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // Relations
  role          Role           @relation(fields: [roleId], references: [id])
  activityLogs  ActivityLog[]
  uploadedFiles StoredFile[]
  refreshFamilies RefreshFamily[]
  notificationCounter NotificationCounter?
  refreshTokens RefreshToken[]
  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")

  @@index([roleId])
}

enum NotificationEmailStatus {
  NOT_REQUESTED
  PENDING
  SENT
  FAILED
}

model Notification {
  sequence BigInt
  emailJob EmailJob?
  @@unique([recipientId, sequence])
  id String @id @default(uuid()) @db.Char(36)
  recipientId String @db.Char(36)
  actorId String? @db.Char(36)
  title String @db.VarChar(160)
  body String @db.VarChar(4000)
  emailStatus NotificationEmailStatus @default(NOT_REQUESTED)
  readAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([recipientId, createdAt, id])
}

// ─────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────

model ActivityLog {
  id        String  @id @default(uuid()) @db.Char(36)
  behavior  String @db.VarChar(64)
  module    String @db.VarChar(64)
  entityId  String? @db.VarChar(128)
  userId    String? @db.Char(36)
  actorIdSnapshot String? @db.Char(36)
  before    Json?
  after     Json?
  requestId String? @db.VarChar(128)
  endpointId String? @db.VarChar(128)

  createdAt DateTime @default(now()) @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([endpointId, createdAt])
  @@index([createdAt])
  @@map("CrudAuditLog")
}

model StoredFile {
  id           String @id @default(uuid()) @db.Char(36)
  storage      String @db.VarChar(16)
  status       String @default("READY") @db.VarChar(16)
  objectKey    String @unique @db.VarChar(255)
  originalName String @db.VarChar(255)
  mimeType     String @db.VarChar(128)
  size         Int
  uploaderId   String? @db.Char(36)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  uploader     User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([uploaderId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  familyId  String @db.Char(36)
  userId    String @db.Char(36)
  expiresAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  family RefreshFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model RefreshFamily {
  id String @id @db.Char(36)
  userId String @db.Char(36)
  expiresAt DateTime @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]
  @@index([expiresAt, revokedAt])
}

model NotificationCounter {
  recipientId String @id @db.Char(36)
  sequence BigInt @default(0)
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model EmailJob {
  id String @id @default(uuid()) @db.Char(36)
  notificationId String @unique @db.Char(36)
  recipient String @db.VarChar(255)
  title String @db.VarChar(160)
  body String @db.VarChar(4000)
  status String @default("PENDING") @db.VarChar(16)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.DateTime(3)
  leaseUntil DateTime? @db.DateTime(3)
  leaseId String? @db.Char(36)
  completedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@index([status, availableAt, leaseUntil])
}
