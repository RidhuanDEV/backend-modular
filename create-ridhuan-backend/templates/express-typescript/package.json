{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "description": "Opinionated modular Express + TypeScript backend starter with Prisma, Zod, JWT auth, RBAC, caching, and CRUD generation.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias && npm run api-docs",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "make:crud": "tsx src/scripts/generate-crud.ts",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "api-docs": "tsx src/scripts/generate-openapi.ts",
    "api-docs:check": "tsx src/scripts/generate-openapi.ts --check",
    "uploads:cleanup": "node dist/scripts/cleanup-orphan-uploads.js",
    "test": "npm run build && node --test tests/time-docs-audit.test.mjs tests/rate-limit.test.mjs tests/env-policies.test.mjs tests/storage.test.mjs tests/health-cors.test.mjs",
    "test:database": "npm run build && node --test tests/notifications.integration.mjs",
    "verify:template": "npm run test && npm run api-docs:check && npx prisma validate && node scripts/verify-package.mjs"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "zod",
    "jwt",
    "rbac",
    "starter",
    "template",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/multer": "^2.2.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "rate-limit-redis": "^5.0.0",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/speakeasy": "^2.0.10",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.0.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
