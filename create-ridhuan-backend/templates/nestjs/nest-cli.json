{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [{ "name": "@nestjs/swagger/plugin", "options": { "classValidatorShim": true, "introspectComments": false } }]
  }
}
