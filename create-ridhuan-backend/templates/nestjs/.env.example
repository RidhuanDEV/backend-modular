DB_PROVIDER=postgresql
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql://backend:backend@localhost:5432/backend?schema=public
DATABASE_URL_DOCKER=postgresql://backend:backend@postgres:5432/backend?schema=public
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ISSUER=modular-nestjs
JWT_AUDIENCE=modular-nestjs-api
# Refresh session: each rotation extends it by the idle window, up to the
# absolute lifetime counted from login. ABSOLUTE must be >= IDLE.
REFRESH_TOKEN_IDLE_DAYS=30
REFRESH_TOKEN_ABSOLUTE_DAYS=90
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_this_password

# Dynamic policy overrides take effect after restart/redeploy.
ENDPOINT_POLICIES_JSON={}
APP_INSTANCE_COUNT=1
TRUST_PROXY_HOPS=0
RATE_LIMIT_STORE=memory
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_INTERNAL_WINDOW_MS=900000
RATE_LIMIT_INTERNAL_MAX=300
# Add a typed rate group in code, its env keys, and a registry assignment for endpoint-specific quotas.

CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_URL_DOCKER=redis://redis:6379
REDIS_NAMESPACE=modular-nestjs

# API docs (/docs). Defaults to off when NODE_ENV=production; set true to expose them.
# DOCS_ENABLED=false
# Refresh token transport: body (JSON, default) or cookie (httpOnly, needs X-Requested-With on refresh/logout).
REFRESH_TOKEN_TRANSPORT=body
# REFRESH_COOKIE_NAME=refresh_token
# lax/strict when the frontend shares the site (e.g. app.example.com + api.example.com); none for cross-site.
# REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=.example.com
# REFRESH_COOKIE_SECURE=true
UPLOAD_ENABLED=true
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,application/pdf
UPLOAD_ORPHAN_GRACE_HOURS=24
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Optional SMTP provider and SSE broker. The broker is process-local.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Compose host ports and database initialization. Set production values separately.
APP_PORT=3000
POSTGRES_USER=backend
POSTGRES_PASSWORD=backend
POSTGRES_DB=backend
POSTGRES_PORT=5432
# Optional least-privilege PostgreSQL role (Compose, created on the first start of an empty volume).
# Point the app's connection at APP_DB_USER and keep the owner for migrations only.
# APP_DB_USER=app_rw
# APP_DB_PASSWORD=
# MIGRATION_DATABASE_URL_DOCKER=postgresql://backend:backend@postgres:5432/backend?schema=public
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

COMPOSE_PROFILES=

COMPOSE_PROJECT_NAME=nestjs

SMTP_SECURE=false

# Database email outbox worker; SMTP remains optional.
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=60
WORKER_RENEW_SECONDS=20
WORKER_MAX_ATTEMPTS=5
CLEANUP_BATCH_SIZE=500
CLEANUP_SESSION_DAYS=30
CLEANUP_OUTBOX_DAYS=30
CLEANUP_AUDIT_ENABLED=false
CLEANUP_AUDIT_DAYS=365

# Optional telemetry. Add telemetry to COMPOSE_PROFILES only when enabled.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nestjs
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT_DOCKER=http://otel-collector:4318
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
