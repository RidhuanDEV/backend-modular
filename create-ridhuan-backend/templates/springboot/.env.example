APP_NAME=modular-springboot
APP_ENV=development
APP_MODE=http
PORT=8080
APP_PORT=8080
DB_PROVIDER=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=backend
DB_USER=backend
DB_PASSWORD=change-me-local
POSTGRES_PORT=5432
POSTGRES_DB=backend
POSTGRES_USER=backend
POSTGRES_PASSWORD=change-me-local
MYSQL_PORT=3306
MYSQL_DATABASE=backend
MYSQL_USER=backend
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
JWT_SECRET=change-me-use-initialize-for-a-random-secret
JWT_ISSUER=modular-springboot
JWT_AUDIENCE=modular-springboot
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
CORS_ORIGINS=http://localhost:3000
ENDPOINT_POLICIES_JSON={}
APP_INSTANCE_COUNT=1
RATE_LIMIT_STORE=memory
RATE_AUTH_WINDOW_SECONDS=60
RATE_AUTH_MAX=30
RATE_PUBLIC_WINDOW_SECONDS=60
RATE_PUBLIC_MAX=300
RATE_INTERNAL_WINDOW_SECONDS=60
RATE_INTERNAL_MAX=300
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
REDIS_NAMESPACE=modular-springboot
UPLOAD_ENABLED=true
UPLOAD_STORAGE=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,application/pdf,text/plain
S3_ENDPOINT=http://127.0.0.1:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_PREFIX=modular-springboot
S3_ACCESS_KEY_ID=development
S3_SECRET_ACCESS_KEY=change-me-development
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
EMAIL_WORKER_CONCURRENCY=2
EMAIL_POLL_SECONDS=3
EMAIL_LEASE_SECONDS=60
EMAIL_RENEW_SECONDS=20
CLEANUP_DRY_RUN=true
CLEANUP_BATCH=500
CLEANUP_RETENTION_DAYS=30
CLEANUP_AUDIT_ENABLED=false
CLEANUP_AUDIT_RETENTION_DAYS=365
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLE_RATE=1.0
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
COMPOSE_PROJECT_NAME=modular-springboot
COMPOSE_PROFILES=
