# Manual PostgreSQL. Configure strong deployment secrets before startup.
ENVIRONMENT=development
PORT=8000
APP_PORT=8000
# Local Compose uses plaintext DB traffic. External deployments: verify-full with a trusted CA.
DATABASE_TLS=disable
# DATABASE_CA_FILE=/run/secrets/database-ca.pem
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://backend:backend@127.0.0.1:5432/backend
DATABASE_URL_DOCKER=postgresql://backend:backend@postgres:5432/backend
POSTGRES_USER=backend
POSTGRES_PASSWORD=backend
POSTGRES_DB=backend
POSTGRES_PORT=5432
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=modular-fastapi
JWT_AUDIENCE=modular-fastapi-api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENDPOINT_POLICIES_JSON={}
APP_INSTANCE_COUNT=1
# Use redis for more than one API worker/replica.
RATE_LIMIT_STORE=memory
# Auth endpoints
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
# Public endpoints
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
# Internal endpoints
RATE_LIMIT_INTERNAL_WINDOW_MS=900000
RATE_LIMIT_INTERNAL_MAX=300
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_URL_DOCKER=redis://redis:6379
REDIS_NAMESPACE=modular-fastapi
REDIS_PORT=6379
UPLOAD_ENABLED=true
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,application/pdf
UPLOAD_ORPHAN_GRACE_HOURS=24
S3_ENDPOINT=http://127.0.0.1:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=backend-uploads
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
COMPOSE_PROFILES=

COMPOSE_PROJECT_NAME=modular-fastapi
