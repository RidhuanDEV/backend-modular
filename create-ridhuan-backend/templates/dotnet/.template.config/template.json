{
  "$schema": "http://json.schemastore.org/template",
  "author": "RidhuanDEV",
  "classifications": ["Web", "API", "PostgreSQL"],
  "identity": "RidhuanDEV.NetBackend.CSharp",
  "name": "Modular ASP.NET Core PostgreSQL Backend",
  "shortName": "modular-net",
  "sourceName": "ModularBackend",
  "preferNameDirectory": true,
  "symbols": {
    "port": {"type": "parameter", "datatype": "integer", "defaultValue": "5080", "replaces": "5080"}
  },
  "sources": [{
    "source": "./",
    "target": "./",
    "include": [".template.config/template.json", "src/**", "tools/**", "tests/**", "contracts/**", "docs/**", "scripts/**", ".github/workflows/**", "templates/**", "*.md", "LICENSE", "ModularBackend.slnx", "global.json", "Directory.Build.props", "Directory.Packages.props", "NuGet.Config", "dotnet-tools.json", ".gitignore", ".gitattributes", ".dockerignore", ".editorconfig", ".env.example", "Dockerfile", "compose.yaml", "compose.override.yaml.example"],
    "exclude": ["**/bin/**", "**/obj/**", "**/.env", "**/.git/**", "**/uploads/**", "**/artifacts/**", "**/TestResults/**", "**/*.user", "**/launchSettings.json"]
  }]
}
