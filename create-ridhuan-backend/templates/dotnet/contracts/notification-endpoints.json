{
  "source": "shared Notifications API implemented in Express, Go, .NET and NestJS",
  "endpoints": [
    ["notification.create", "POST", "/api/notifications", "notifications", false, "manage_notifications", "required", "internal", "off", 201],
    ["notification.list", "GET", "/api/notifications", "notifications", false, "", "none", "internal", "off", 200],
    ["notification.read", "PATCH", "/api/notifications/{id}/read", "notifications", false, "", "required", "internal", "off", 200],
    ["notification.stream", "GET", "/api/notifications/stream", "notifications", false, "", "none", "internal", "off", 200]
  ]
}
