# Copy to .env; replace CHANGE_ME values. .NET does not load .env automatically.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
APP_PORT=5080
POSTGRES_PORT=55432
POSTGRES_DB=modular_net
POSTGRES_USER=modular_net
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
Database__ConnectionString=Host=127.0.0.1;Port=55432;Database=modular_net;Username=modular_net;Password=CHANGE_ME_DATABASE_PASSWORD
Jwt__Secret=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
Jwt__Issuer=modular-net
Jwt__Audience=modular-net-clients
Cors__Origins__0=http://localhost:5173
Cors__Origins__1=http://localhost:3000
Rate__Prefix=modular-net:v1
Rate__Store=memory
Rate__InstanceCount=1
Rate__Auth__Max=20
Rate__Auth__WindowMs=60000
Rate__Public__Max=100
Rate__Public__WindowMs=60000
Rate__Internal__Max=200
Rate__Internal__WindowMs=60000
Redis__ConnectionString=127.0.0.1:56379
REDIS_PORT=56379
Cache__Enabled=false
Cache__Prefix=modular-net:v1
Cache__TtlSeconds=60
Upload__Enabled=true
Upload__Storage=local
Upload__LocalRoot=uploads
Upload__MaxBytes=10485760
Upload__AllowedMime__0=image/png
Upload__AllowedMime__1=image/jpeg
Upload__AllowedMime__2=application/pdf
Upload__OrphanGraceHours=24
Upload__Endpoint=http://127.0.0.1:19000
Upload__Region=us-east-1
Upload__Bucket=uploads
Upload__ForcePathStyle=true
Upload__AccessKey=CHANGE_ME_S3_ACCESS_KEY
Upload__SecretKey=CHANGE_ME_S3_SECRET_KEY
S3_PORT=19000
Telemetry__Enabled=false
Telemetry__Endpoint=http://localhost:4317
Telemetry__ServiceName=modular-net
Bootstrap__Email=admin@example.test
Bootstrap__Password=CHANGE_ME_BOOTSTRAP_PASSWORD
ENDPOINT_POLICIES_JSON={}
Smtp__Enabled=false
Smtp__Host=
Smtp__Port=587
Smtp__Secure=false
Smtp__User=
Smtp__Password=
Smtp__From=
COMPOSE_PROFILES=

# Forwarded headers are ignored unless explicit trusted proxy IPs are set.
# Proxy__KnownProxies__0=127.0.0.1
Proxy__ForwardLimit=1

Database__ConnectionString_DOCKER=Host=postgres;Port=5432;Database=modular_net;Username=modular_net;Password=CHANGE_ME_DATABASE_PASSWORD

S3_ENDPOINT_DOCKER=http://s3mock:9090

COMPOSE_PROJECT_NAME=modular-net
