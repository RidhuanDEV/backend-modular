{
  "name": "create-ridhuan-backend",
  "version": "1.2.0",
  "description": "Multi-template CLI for Express TypeScript, NestJS, Golang, and .NET backends",
  "type": "module",
  "bin": {
    "create-ridhuan-backend": "./dist/bin/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0 <27"
  },
  "keywords": [
    "cli",
    "starter",
    "template",
    "modular",
    "express",
    "typescript",
    "nestjs",
    "golang",
    "dotnet",
    "postgresql",
    "prisma",
    "sqlc",
    "efcore"
  ],
  "author": "RidhuanDEV",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RidhuanDEV/backend-modular.git",
    "directory": "create-ridhuan-backend"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare:templates": "node ./scripts/prepare-templates.mjs",
    "build": "node scripts/clean-build.mjs && tsc",
    "prepack": "npm run prepare:templates && npm run build",
    "test": "node ./scripts/verify-cli.mjs",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "test:compose": "node scripts/verify-compose.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@inquirer/password": "^5.2.2",
    "pg": "^8.23.0",
    "semver": "^7.8.5"
  },
  "bugs": {
    "url": "https://github.com/RidhuanDEV/backend-modular/issues"
  },
  "homepage": "https://github.com/RidhuanDEV/backend-modular/tree/main/create-ridhuan-backend#readme"
}
